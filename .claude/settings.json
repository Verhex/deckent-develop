{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__deckent__deckent_kill|mcp__deckent__deckent_cleanup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-guard.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/sync-core-memory.mjs\" --target \"$HOME/.claude/projects/-home-alperen-deckent-dev/memory\""
          }
        ]
      }
    ]
  }
}
