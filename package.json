{
  "name": "deckent",
  "version": "0.2.0-beta.1",
  "description": "AI agent orchestration system — your AI development team, orchestrated.",
  "type": "module",
  "bin": {
    "deckent": "./dist/cli/entry.js",
    "deckent-mcp": "./dist/mcp/server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dashboard": "vitest run --config vitest.dashboard.config.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "validate:publish": "npx tsx scripts/validate-publish.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "claude",
    "cli",
    "agents",
    "skills",
    "marketplace",
    "analytics"
  ],
  "author": "Alperen @ Verhex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VerhexIO/deckent.git"
  },
  "bugs": {
    "url": "https://github.com/VerhexIO/deckent/issues"
  },
  "homepage": "https://deckent.agency",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "commander": "^13.0.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^20.8.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
