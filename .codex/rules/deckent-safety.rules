# Owner-approval gates for commands that must remain possible but never run
# without an explicit prompt. Project-local execpolicy rules are loaded only
# for trusted projects and can be bypassed with `--ignore-rules`; enterprise
# installations that need an unbypassable boundary must promote these rules to
# managed requirements.

prefix_rule(
    pattern = ["git", ["commit", "push"]],
    decision = "prompt",
    justification = "Commit/push yalnız Alperen isteyince; önce `git branch -vv` ile shared-worktree HEAD-drift kontrol edilir.",
    match = [
        "git commit -m example",
        "git push",
        "git push origin main",
    ],
    not_match = [
        "git status --short",
        "git branch -vv",
    ],
)

prefix_rule(
    pattern = ["deckent", ["kill", "cleanup"]],
    decision = "prompt",
    justification = "deckent kill/cleanup canlı sprint state'ine yalnız owner onayıyla dokunabilir.",
    match = [
        "deckent kill",
        "deckent cleanup",
        "deckent kill --task 001-001",
    ],
    not_match = [
        "deckent status",
        "deckent history",
    ],
)

prefix_rule(
    pattern = ["env", "-u", "ANTHROPIC_API_KEY", "deckent", ["kill", "cleanup"]],
    decision = "prompt",
    justification = "Environment wrapper, deckent kill/cleanup owner-onay kapısını kaldıramaz.",
    match = [
        "env -u ANTHROPIC_API_KEY deckent kill",
        "env -u ANTHROPIC_API_KEY deckent cleanup",
    ],
    not_match = [
        "env -u ANTHROPIC_API_KEY deckent status",
    ],
)

prefix_rule(
    pattern = ["npx", "deckent", ["kill", "cleanup"]],
    decision = "prompt",
    justification = "npx wrapper, deckent kill/cleanup owner-onay kapısını kaldıramaz.",
    match = [
        "npx deckent kill",
        "npx deckent cleanup",
    ],
    not_match = [
        "npx deckent status",
    ],
)

prefix_rule(
    pattern = ["./node_modules/.bin/deckent", ["kill", "cleanup"]],
    decision = "prompt",
    justification = "Local binary path, deckent kill/cleanup owner-onay kapısını kaldıramaz.",
    match = [
        "./node_modules/.bin/deckent kill",
        "./node_modules/.bin/deckent cleanup",
    ],
    not_match = [
        "./node_modules/.bin/deckent status",
    ],
)

prefix_rule(
    pattern = ["node", "dist/cli/entry.js", ["kill", "cleanup"]],
    decision = "prompt",
    justification = "Direct CLI entry, deckent kill/cleanup owner-onay kapısını kaldıramaz.",
    match = [
        "node dist/cli/entry.js kill",
        "node dist/cli/entry.js cleanup",
    ],
    not_match = [
        "node dist/cli/entry.js status",
    ],
)
