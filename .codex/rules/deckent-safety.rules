# Owner-approval gates for commands that must remain possible but never run
# without authorization. Project-local execpolicy rules are loaded only for
# trusted projects and can be bypassed with `--ignore-rules`; enterprise
# installations that need an unbypassable boundary must promote these rules to
# managed requirements. Commit authorization is enforced by the repository
# contract because a `prompt` decision deadlocks headless/never-approval hosts;
# push remains an interactive execpolicy boundary. Kill/cleanup authorization
# is likewise enforced by the repository contract: a `prompt` rule cannot
# consume an already-given owner approval on never-approval hosts and therefore
# deadlocks the canonical cleanup command itself.

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    match = [
        "git commit -m example",
    ],
    not_match = [
        "git push",
        "git status --short",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Push yalnız Alperen isteyince; önce `git branch -vv` ile shared-worktree HEAD-drift kontrol edilir.",
    match = [
        "git push",
        "git push origin main",
    ],
    not_match = [
        "git status --short",
        "git branch -vv",
    ],
)

prefix_rule(
    pattern = ["deckent", ["kill", "cleanup"]],
    decision = "allow",
    match = [
        "deckent kill",
        "deckent cleanup",
        "deckent kill --task 001-001",
    ],
    not_match = [
        "deckent status",
        "deckent history",
    ],
)

prefix_rule(
    pattern = ["env", "-u", "ANTHROPIC_API_KEY", "deckent", ["kill", "cleanup"]],
    decision = "allow",
    match = [
        "env -u ANTHROPIC_API_KEY deckent kill",
        "env -u ANTHROPIC_API_KEY deckent cleanup",
    ],
    not_match = [
        "env -u ANTHROPIC_API_KEY deckent status",
    ],
)

prefix_rule(
    pattern = ["npx", "deckent", ["kill", "cleanup"]],
    decision = "allow",
    match = [
        "npx deckent kill",
        "npx deckent cleanup",
    ],
    not_match = [
        "npx deckent status",
    ],
)

prefix_rule(
    pattern = ["./node_modules/.bin/deckent", ["kill", "cleanup"]],
    decision = "allow",
    match = [
        "./node_modules/.bin/deckent kill",
        "./node_modules/.bin/deckent cleanup",
    ],
    not_match = [
        "./node_modules/.bin/deckent status",
    ],
)

prefix_rule(
    pattern = ["node", "dist/cli/entry.js", ["kill", "cleanup"]],
    decision = "allow",
    match = [
        "node dist/cli/entry.js kill",
        "node dist/cli/entry.js cleanup",
    ],
    not_match = [
        "node dist/cli/entry.js status",
    ],
)
