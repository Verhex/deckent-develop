{
  "id": "translator",
  "source": "hub",
  "name": "Translator",
  "version": "1.0.0",
  "description": "DeepL API integration for high-quality translation, batch processing, and document translation",
  "manifestVersion": 2,
  "activation": {
    "rules": [
      { "when": { "domains": { "$contains": "translation" } }, "score": 8 },
      { "when": { "domains": { "$contains": "i18n" } }, "score": 7 },
      { "when": { "domains": { "$contains": "localization" } }, "score": 7 }
    ],
    "exclude": [],
    "minScore": 5
  },
  "entrypoint": "SKILL.md",
  "category": "integration",
  "triggers": ["translate", "language", "deepl", "localize", "i18n", "multilingual"],
  "stackDetection": { "files": [], "dependencies": ["deepl-node"], "commands": [] },
  "composableWith": ["typescript-expert", "api-builder"],
  "priority": 10,
  "promptInjection": { "position": "prepend", "maxTokens": 1500 },
  "enabled": true,
  "stats": { "totalUses": 0, "successCount": 0, "successRate": 0, "avgCoverage": 0, "lastUsedInSprint": null }
}
