+export class ProjectionIntegrityHoldError extends Error {
+  readonly code = PROJECTION_INTEGRITY_HOLD;
+
+  constructor(
+    readonly issue: ProjectionIntegrityIssue,
+    readonly projection: string,
+  ) {
+    super(`${PROJECTION_INTEGRITY_HOLD}:${projection}:${issue}`);
+    this.name = 'ProjectionIntegrityHoldError';
+  }
