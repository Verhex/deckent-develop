+/**
+ * Bind reusable gate evidence to the current bytes of every host-authorized
+ * write/attribution path. Symlinks are hashed as links (never followed), absent
+ * paths remain explicit evidence, and the logical settlement digest keeps the
+ * source snapshot tied to the exact attempt lineage.
+ */
+export function deriveFinalizerGateCodeDigest(
+  projectRoot: string,
+  tasks: readonly Task[],
+  results: readonly TaskResult[],
+  logicalSettlementDigest: string,
+): string {
+  const paths = new Set<string>();
+  for (const task of tasks) {
+    for (const candidate of task.scope.filesWrite) {
+      const normalized = normalizeScopedAuditPath(candidate);
+      if (normalized) paths.add(normalized);
+    }
+  }
+  for (const result of results) {
+    for (const candidate of normalizeChangedPaths(result.filesChanged)) {
+      const normalized = normalizeScopedAuditPath(candidate);
+      if (normalized) paths.add(normalized);
+    }
+  }
+
+  const entries = [...paths].sort().map(path => {
+    const absolutePath = join(projectRoot, ...path.split('/'));
+    try {
+      const stat = lstatSync(absolutePath);
+      if (stat.isSymbolicLink()) {
+        return [path, 'symlink', createHash('sha256').update(readlinkSync(absolutePath)).digest('hex')];
+      }
+      if (!stat.isFile()) return [path, stat.isDirectory() ? 'directory' : 'non-file', null];
+      return [path, 'file', createHash('sha256').update(readFileSync(absolutePath)).digest('hex')];
+    } catch {
+      return [path, 'absent-or-unreadable', null];
+    }
+  });
+  return createHash('sha256')
+    .update(JSON.stringify({ logicalSettlementDigest, entries }))
+    .digest('hex');
+}
