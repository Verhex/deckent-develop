+export function assertManagedProjectionCoherence(options: ProjectionCoherenceOptions): void {
+  const root = resolve(options.projectRoot);
+  const runtimePath = resolve(fileURLToPath(options.runtimeModuleUrl));
+  const runtimeRelative = relative(root, runtimePath).split('\\').join('/');
+  // Source execution is current. A package outside projectRoot is an installed
+  // consumer and intentionally has no Deckent source-tree obligation.
+  if (runtimeRelative.startsWith('../') || runtimeRelative === '..') return;
+  if (runtimeRelative.startsWith('src/')) return;
+  if (!runtimeRelative.startsWith('dist/')) return;
