+describe('coalesced operation-local custody reads', () => {
+  const bounds = { maxEntries: 10_000, maxBytes: 16 * 1024 * 1024, maxDurationMs: 10_000 };
+  it('shares physical task bytes, copies caller buffers and still rereads at the final fence', () => {
+    const adapter = new InMemoryCustodyAdapter();
+    const firstReads = vi.spyOn(adapter, 'readFirstWriter');
+    const verifiedReads = vi.spyOn(adapter, 'readVerified');
+    const { store } = openedStore(adapter);
+    const p = policy(), id = identity(), admission = admit(store, id, p);
+    firstReads.mockClear();
+    verifiedReads.mockClear();
+    const input = { identity: id, policy: p, admissionReceiptDigest: admission.receiptDigest };
+    const outcome = store.withVerifiedReadSnapshot(bounds, () => {
+      const first = store.readTaskSnapshot(input)!;
+      const expected = new Uint8Array(first.bytes);
+      first.bytes.fill(0);
+      const second = store.readTaskSnapshot(input)!;
+      expect(second.bytes).toEqual(expected);
+      return second.proof;
+    });
+    expect(outcome.value).toEqual(admission.taskSnapshot);
+    expect(firstReads.mock.calls.filter(([arg]) => arg.relativePath === admission.taskSnapshot.relativePath)).toHaveLength(2);
