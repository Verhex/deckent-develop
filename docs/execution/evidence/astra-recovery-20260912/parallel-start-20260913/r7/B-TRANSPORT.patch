@@ -0,0 +1,61 @@
+import { Worker } from 'node:worker_threads';
+import { parseExactDockerCommandDiagnostic } from './exact-docker-command-diagnostic.js';
+import { runExactDockerWorkspaceCommand, type ExactDockerWorkspaceCommandInputV1,
+  type ExactDockerWorkspaceCommandResultV1, type ExactDockerWorkspaceCommandRunnerV1,
+} from './exact-docker-workspace-command.js';
+
+function unavailable(): ExactDockerWorkspaceCommandResultV1 {
+  return Object.freeze({ status: null, signal: null, stdout: Buffer.alloc(0),
+    stderr: Buffer.alloc(0), error: true, overflow: false });
+}
+
+/** Transport only: the calling lifecycle owns admission and exact command scope.
+ * The same bounded runner owns the child in a separate event loop so synchronous
+ * coordinator work cannot stall pipes or manufacture a subprocess timeout.
+ * This does not grant authority to execute any command or accept any result. */
+export async function runIsolatedExactDockerCommandTransport(
+  input: ExactDockerWorkspaceCommandInputV1,
+): Promise<ExactDockerWorkspaceCommandResultV1> {
+  return await new Promise(resolveResult => {
+    let worker: Worker;
+    let result: ExactDockerWorkspaceCommandResultV1 | undefined;
+    try {
+      worker = new Worker(new URL('./exact-docker-container-observation-worker.js', import.meta.url), {
+        workerData: input,
+        // --input-type only applies to the calling eval/stdin script, not a file.
+        execArgv: process.execArgv.filter(arg => !arg.startsWith('--input-type')),
+      });
+    } catch { resolveResult(unavailable()); return; }
+    worker.once('message', (message: ExactDockerWorkspaceCommandResultV1) => {
+      if (!message || (message.status !== null && !Number.isSafeInteger(message.status))
+        || (message.signal !== null && typeof message.signal !== 'string')
+        || typeof message.error !== 'boolean' || typeof message.overflow !== 'boolean'
+        || !(message.stdout instanceof Uint8Array) || !(message.stderr instanceof Uint8Array)
+        || message.stdout.byteLength > input.stdoutCeiling
+        || message.stderr.byteLength > input.stderrCeiling) {
+        result = unavailable(); return;
+      }
+      const diagnostic = message.diagnostic === undefined ? undefined
+        : parseExactDockerCommandDiagnostic(message.diagnostic);
+      if (diagnostic === null) { result = unavailable(); return; }
+      result = Object.freeze({ ...message, ...(diagnostic ? { diagnostic } : {}) });
+    });
+    worker.once('error', () => { result = unavailable(); });
+    // Only resolve after the command transport thread has retired. No detached poller
+    // or subprocess is deliberately left behind after a successful result.
+    worker.once('exit', code => resolveResult(code === 0 && result ? result : unavailable()));
+  });
+}
+
+/** Used only after the lifecycle producer has built an admitted capture command.
+ * Population and other mutation paths do not opt in. Custom platform runners
+ * keep their identity and their own custody/transport contract. */
+export function resolveExactDockerEffectCaptureRunner(
+  runner: ExactDockerWorkspaceCommandRunnerV1,
+): ExactDockerWorkspaceCommandRunnerV1 {
+  return runner === runExactDockerWorkspaceCommand
+    ? input => input.command === 'docker' && input.args[0] === 'run'
+      && input.stdin.byteLength === 0
+      ? runIsolatedExactDockerCommandTransport(input) : Promise.resolve(unavailable())
+    : runner;
+}
