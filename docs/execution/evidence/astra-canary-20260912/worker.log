).mockImplementationOnce(() => {\ntests/core/observability.test.ts:495:      throw new Error('simulated rotation failure');\ntests/core/observability.test.ts-496-    });\ntests/core/observability.test.ts-497-\ntests/core/observability.test.ts-498-    expect(() => {\ntests/core/observability.test.ts-499-      for (let i = 0; i < 20; i++) {\ntests/core/observability.test.ts-500-        metric('failure.isolation.test', i, { i: String(i) });\ntests/core/observability.test.ts-501-      }\ntests/core/observability.test.ts-502-    }).not.toThrow();\ntests/core/observability.test.ts-503-\ntests/core/observability.test.ts:504:    expect(vi.mocked(rotateMetricsFile).mock.calls.length).toBeGreaterThanOrEqual(2);\ntests/core/observability.test.ts:505:    expect(vi.mocked(shouldRotate).mock.calls.length).toBeLessThan(20);\ntests/core/observability.test.ts-506-\ntests/core/observability.test.ts-507-    const persistedNames = [\ntests/core/observability.test.ts-508-      ...readMetricsLines(),\ntests/core/observability.test.ts-509-      ...listArchives(TEST_ROOT).flatMap(path => gunzipSync(readFileSync(path)).toString('utf-8').split('\\n').filter(Boolean)),\ntests/core/observability.test.ts-510-    ].map(line => (JSON.parse(line) as MetricEntry).name);\ntests/core/observability.test.ts-511-    expect(persistedNames.filter(name => name === 'failure.isolation.test')).toHaveLength(20);\ntests/core/observability.test.ts-512-\ntests/core/observability.test.ts:513:    // The caller keeps working after a rotation failure — the failure never\ntests/core/observability.test.ts-514-    // breaks subsequent telemetry writes.\ntests/core/observability.test.ts-515-    expect(() => metric('after.failure', 1)).not.toThrow();\ntests/core/observability.test.ts-516-    const namesAfterRecovery = [\ntests/core/observability.test.ts-517-      ...readMetricsLines(),\ntests/core/observability.test.ts-518-      ...listArchives(TEST_ROOT).flatMap(path => gunzipSync(readFileSync(path)).toString('utf-8').sp