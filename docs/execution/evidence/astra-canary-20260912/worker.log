pend, upcomingBytes);\n\\\"\\\"\\\"\nassert old in s\ns = s.replace(old, new)\nold = \\\"\\\"\\\"  const taggedEntry = injectSprintId(entry);\n  const line = JSON.stringify(taggedEntry) + '\\\\\\\\n';\n\n  try {\n    // Always write to main metrics file\n\\\"\\\"\\\"\nnew = \\\"\\\"\\\"  try {\n    const taggedEntry = injectSprintId(entry);\n    const line = JSON.stringify(taggedEntry) + '\\\\\\\\n';\n\n    // Always write to main metrics file\n\\\"\\\"\\\"\nassert old in s\ns = s.replace(old, new)\np.write_text(s)\n\np = Path('tests/core/observability.test.ts')\ns = p.read_text()\ns = s.replace(\\\"\\\"\\\"    // Force exactly one rotation attempt to fail. The policy remains due so\n    // a later amortized retry must exercise the real rotation in this session.\n    vi.mocked(shouldRotate).mockReturnValue(true);\n    vi.mocked(rotateMetricsFile).mockImplementationOnce(() => {\n\\\"\\\"\\\", \\\"\\\"\\\"    // Seed a file over the actual configured ceiling. The failure uses the\n    // real policy resolver, so retries prove production behavior rather than a\n    // perpetual-due mock.\n    writeFileSync(METRICS_PATH, \"'`${JSON.stringify({ type: '\"'metric', name: 'seed', value: 0, tags: { payload: 'x'.repeat(2_000) }, timestamp: new Date().toISOString() })}\\\\\\\\n\"'`, '\"'utf-8');\n    vi.mocked(rotateMetricsFile).mockImplementationOnce(() => {\n\\\"\\\"\\\")\nassert \\\"vi.mocked(shouldRotate).mockReturnValue(true);\\\" not in s\np.write_text(s)\nPY\ncat > .tasks/task-751-001.landing-proposal.json <<'EOF'\n{\\\"version\\\":3,\\\"taskId\\\":\\\"751-001\\\",\\\"dispatchRequestId\\\":\\\"dreq-2c97eeee97075ce9b84b93893375b3dfaf91e219ab67bbfaa7b010c76757e83a\\\",\\\"sequence\\\":3,\\\"summary\\\":\\\"Applied scoped policy-distance scheduling, serialization isolation, and real-policy transient recovery coverage.\\\",\\\"completedWork\\\":[\\\"Read allowed implementation and tests\\\",\\\"Confirmed retention tenant/legal-hold implementation remains in rotation authori