+// ═══ Plan Cache (Sprint 280 — PLANOBS-005) ════════════════════════
+// Avoid re-invoking the planner when DIRECTIVES is unchanged AND a freshly
+// planned (not-yet-executed) set of task-*.json files already exists on disk.
+// The `deckent start` flow planned the sprint twice in a single non-force run
+// (cost-gate estimate, then runSprint) and re-planned on EVERY invocation; this
+// wrapper makes start.ts plan through a single cache-aware entry point so a
+// preview→start (or cost-block→--force) re-run reuses the existing plan instead
+// of paying the AI/structured planner cost again.
+//
+// Safety: the cache is gated by BOTH a DIRECTIVES content hash AND the next
+// sprint id — once a sprint has run (`last_sprint_id` bumps → next id advances)
+// the cached plan no longer matches and is re-planned, so stale executed tasks
+// are never reused. All cache I/O is fail-safe (errors fall through to a normal
+// plan), so a corrupt/missing marker never blocks sprint start.
+
+const PLAN_CACHE_FILE = '.plan-cache.json';
+
+export interface PlanCacheMeta {
+  /** SHA-256 of the DIRECTIVES content the cached plan was derived from. */
+  directivesHash: string;
+  /** Sprint id of the cached plan (must equal the next sprint id to be fresh). */
+  sprintId: string;
+  /** Ids of the task-*.json files written by the cached plan. */
+  taskIds: string[];
+  /** ISO timestamp the cache was written (diagnostics only). */
+  cachedAt: string;
+}
+
+/** Optional dependency override for `planSprintCached` (test seam). */
+export interface PlanSprintCachedDeps {
+  /** Planner to invoke on a cache miss. Defaults to {@link planSprint}. */
+  planFn?: typeof planSprint;
+}
+
+/** Compute the cache key for a DIRECTIVES body. */
+export function computeDirectivesHash(directives: string): string {
+  return createHash('sha256').update(directives ?? '', 'utf-8').digest('hex');
+}
+
+function planCachePath(projectRoot: string): string {
+  return join(projectRoot, TASKS_DIR, PLAN_CACHE_FILE);
+}
+
+/** Read the plan-cache marker; returns null when absent or unparseable. */
+export function readPlanCache(projectRoot: string): PlanCacheMeta | null {
+  return readJsonSafe<PlanCacheMeta>(planCachePath(projectRoot));
+}
+
+/** Persist the plan-cache marker. Fail-safe — never throws. */
+export function writePlanCache(projectRoot: string, meta: PlanCacheMeta): void {
+  try {
+    mkdirSync(join(projectRoot, TASKS_DIR), { recursive: true });
+    writeFileSync(planCachePath(projectRoot), JSON.stringify(meta, null, 2), 'utf-8');
+  } catch (e) {
+    debugLog('writePlanCache', e);
+  }
+}
+
+/**
+ * Reconstruct a planned {@link Sprint} from the cached task-*.json files.
+ * Returns null when any referenced task file is missing (stale cache) so the
+ * caller falls back to a fresh plan.
+ */
+export function loadCachedSprint(projectRoot: string, meta: PlanCacheMeta): Sprint | null {
+  const tasksPath = join(projectRoot, TASKS_DIR);
+  if (!existsSync(tasksPath)) return null;
+  const tasks: Task[] = [];
+  for (const id of meta.taskIds) {
+    const task = readJsonSafe<Task>(join(tasksPath, `task-${id}.json`));
+    if (!task) return null; // missing file → stale cache → re-plan
+    tasks.push(task);
+  }
+  if (tasks.length === 0) return null;
+  return {
+    id: meta.sprintId,
+    number: parseInt(meta.sprintId.replace('sprint-', ''), 10),
+    status: SprintStatus.PLANNING,
+    phase: SprintPhase.PLAN,
+    tasks,
+    workers: tasks.map(t => `w-${t.id}`),
+  };
+}
+
+/**
+ * Cache-aware wrapper over {@link planSprint}.
+ *
+ * On a cache hit — DIRECTIVES hash unchanged AND the cached sprint id still
+ * equals the next sprint id (i.e. the plan has not yet executed) AND every
+ * task file is present — the existing plan is reused and the planner is NOT
+ * invoked (`fromCache: true`). Otherwise the planner runs and the cache marker
+ * is refreshed (`fromCache: false`).
+ *
+ * Fail-safe: any cache read/parse error falls through to a normal plan.
+ *
+ * @param deps.planFn Injectable planner for tests; defaults to {@link planSprint}.
+ */
+export async function planSprintCached(
+  projectRoot: string,
+  config: ResolvedConfig,
+  context: BrainContext,
+  recommendation: SprintSizeRecommendation,
+  options?: { mode?: BrainPlanningMode; asDraft?: boolean; dryRun?: boolean },
+  deps?: PlanSprintCachedDeps,
+): Promise<{ sprint: Sprint; fromCache: boolean }> {
+  const planFn = deps?.planFn ?? planSprint;
+  const hash = computeDirectivesHash(context.directives);
+
+  // ─── Cache lookup (fail-safe) ────────────────────────────────────
+  try {
+    const cache = readPlanCache(projectRoot);
+    if (
+      cache &&
+      cache.directivesHash === hash &&
+      cache.sprintId === getNextSprintId(projectRoot)
+    ) {
+      const cached = loadCachedSprint(projectRoot, cache);
+      if (cached) return { sprint: cached, fromCache: true };
+    }
+  } catch (e) {
+    debugLog('planSprintCached:read', e);
+  }
+
+  // ─── Cache miss → fresh plan + refresh marker ────────────────────
+  const sprint = await planFn(projectRoot, config, context, recommendation, options);
+
+  // Only cache real plans: planSprint skips task-file writes when options.dryRun
+  // is set, so a dryRun plan leaves nothing to reconstruct from — never mark it
+  // fresh (loadCachedSprint would just miss next time, but this avoids a marker
+  // that points at non-existent files).
+  if (!options?.dryRun) {
+    writePlanCache(projectRoot, {
+      directivesHash: hash,
+      sprintId: sprint.id,
+      taskIds: sprint.tasks.map(t => t.id),
+      cachedAt: now(),
+    });
+  }
+
+  return { sprint, fromCache: false };
+}
