{
  "id": "devops-engineer",
  "source": "builtin",
  "name": "DevOps Engineer",
  "version": "0.2.0",
  "description": "Docker, CI/CD, GitHub Actions, infrastructure, deployment, monitoring",
  "manifestVersion": 2,
  "activation": {
    "rules": [
      {
        "when": {
