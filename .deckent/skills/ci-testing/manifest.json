{
  "id": "ci-testing",
  "source": "builtin",
  "name": "CI Testing Expert",
  "version": "1.0.0",
  "description": "CI/CD testing expertise — regression detection, coverage analysis, test strategy",
  "manifestVersion": 2,
  "activation": {
    "rules": [
      {
        "when": {
          "intent.primary": "testing"
        },
        "score": 10
      },
      {
        "when": {
          "intent.primary": "devops"
        },
        "score": 8
      }
    ],
    "exclude": [
      {
        "when": {
          "intent.primary": "implementation"
        }
      }
    ],
    "minScore": 5
  },
  "entrypoint": "SKILL.md",
  "category": "workflow",
  "triggers": [
    "ci",
    "test",
    "regression",
    "coverage",
    "pipeline",
    "build",
    "lint",
    "actions"
  ],
  "stackDetection": {
    "files": [
      ".github/workflows/*.yml",
      ".gitlab-ci.yml",
      "Makefile",
      "vitest.config.*",
      "pytest.ini",
      "pyproject.toml",
      "go.mod",
      "Cargo.toml"
    ],
    "dependencies": [
      "vitest",
      "jest",
      "pytest",
      "typescript"
    ],
    "commands": []
  },
  "composableWith": [
    "testing-expert",
    "typescript-expert",
    "python-expert",
    "devops-engineer"
  ],
  "priority": 12,
  "promptInjection": {
    "position": "prepend",
    "maxTokens": 1500
  },
  "enabled": true,
  "stats": {
    "totalUses": 74,
    "successCount": 57,
    "successRate": 0.7702702702702703,
    "avgScore": 0,
    "lastUsedInSprint": "sprint-247"
  }
}
