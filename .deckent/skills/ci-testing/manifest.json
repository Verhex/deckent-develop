{
  "id": "ci-testing",
  "source": "builtin",
  "name": "CI Testing Expert",
  "version": "1.0.0",
  "description": "CI/CD testing expertise — regression detection, coverage analysis, test strategy",
  "manifestVersion": 2,
  "activation": {
    "rules": [
      {
        "when": {
          "intent.primary": "testing"
        },
        "score": 10
      },
      {
        "when": {
          "intent.primary": "devops"
        },
        "score": 8
      }
    ],
    "exclude": [
      {
        "when": {
          "intent.primary": "implementation"
        }
      }
    ],
    "minScore": 5
  },
  "entrypoint": "SKILL.md",
  "category": "workflow",
  "triggers": [
    "ci",
    "test",
    "regression",
    "coverage",
    "pipeline",
    "build",
    "lint",
    "actions"
  ],
  "stackDetection": {
    "files": [
      ".github/workflows/*.yml",
      "vitest.config.*",
      "tsconfig.json"
    ],
    "dependencies": [
      "vitest",
      "typescript"
    ],
    "commands": [
      "tsc",
      "vitest"
    ]
  },
  "composableWith": [
    "testing-expert",
    "typescript-expert"
  ],
  "priority": 12,
  "promptInjection": {
    "position": "prepend",
    "maxTokens": 1500
  },
  "enabled": true,
  "stats": {
    "totalUses": 14,
    "successCount": 9,
    "successRate": 0.6428571428571429,
    "avgCoverage": 0,
    "lastUsedInSprint": "sprint-167"
  }
}
