{
  "id": "deckent-worker-evidence",
  "source": "builtin",
  "name": "Deckent Worker Evidence",
  "version": "0.1.1",
  "description": "Deckent workflow for disk-first result claims, captured verification output, typed honest verdicts, and real-binary proof of user-facing function",
  "manifestVersion": 2,
  "activation": {
    "rules": [
      {
        "when": {
          "domains": {
            "$contains": "workers"
          },
          "intent.primary": "implementation"
        },
        "score": 10
      }
    ],
    "exclude": [],
    "minScore": 5
  },
  "profile": {
    "profileVersion": 3,
    "workTypes": [
      { "type": "review", "proficiency": "primary" },
      { "type": "analyze", "proficiency": "secondary" },
      { "type": "document", "proficiency": "able" }
    ],
    "domains": [
      { "id": "workers", "proficiency": "primary" }
    ],
    "expertise": [
      "disk-derived worker evidence",
      "result ingress claims",
      "typed NO_GO verdicts",
      "real-binary proof of function"
    ],
    "deliverables": ["doc"]
  },
  "entrypoint": "SKILL.md",
  "category": "workflow",
  "triggers": [
    "worker-evidence",
    "result-file",
    "self-assessment",
    "no-go",
    "proof-of-function",
    "disk-evidence"
  ],
  "stackDetection": {
    "files": [".tasks/*.result", ".claude/rules/worker-default.md"],
    "dependencies": [],
    "commands": []
  },
  "composableWith": ["testing-expert", "technical-writer"],
  "priority": 7,
  "promptInjection": {
    "position": "prepend",
    "maxTokens": 1500
  },
  "enabled": true,
  "stats": {
    "totalUses": 0,
    "successCount": 0,
    "successRate": 0,
    "avgCoverage": 0,
    "lastUsedInSprint": ""
  }
}
