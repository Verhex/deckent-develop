{
  "id": "i18n-quality",
  "name": "i18n Quality",
  "version": "0.3.1",
  "description": "Deckent i18n quality: require registered en+tr catalog pairs, resolve user-facing copy with getMessage, preserve missing-key diagnostics, and keep mechanism modules string-free",
  "entrypoint": "SKILL.md",
  "category": "workflow",
  "manifestVersion": 2,
  "triggers": [
    "i18n",
    "getMessage",
    "localization",
    "hardcoded string"
  ],
  "stackDetection": {
    "files": [],
    "dependencies": [],
    "commands": []
  },
  "composableWith": [
    "typescript-expert",
    "frontend-design"
  ],
  "priority": 6,
  "promptInjection": {
    "position": "append",
    "maxTokens": 1500
  },
  "enabled": true,
  "source": "builtin",
  "stats": {
    "totalUses": 0,
    "successCount": 0,
    "successRate": 0,
    "avgCoverage": 0
  },
  "activation": {
    "rules": [
      {
        "name": "cli-surface",
        "when": {
          "domains": {
            "$contains": "cli"
          },
          "intent.primary": "implementation"
        },
        "score": 6
      },
      {
        "name": "dashboard-surface",
        "when": {
          "domains": {
            "$contains": "dashboard"
          },
          "intent.primary": "implementation"
        },
        "score": 5
      }
    ],
    "exclude": [],
    "minScore": 5
  }
}
