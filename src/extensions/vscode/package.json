{
  "name": "deckent-vscode",
  "displayName": "Deckent — AI Agent Orchestrator",
  "description": "Sprint-based AI agent orchestration for VS Code",
  "version": "0.1.0",
  "publisher": "verhex",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "deckent.start", "title": "Deckent: Start Sprint" },
      { "command": "deckent.status", "title": "Deckent: Show Status" },
      { "command": "deckent.explain", "title": "Deckent: Explain Last Sprint" }
    ]
  }
}
