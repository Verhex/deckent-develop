{
  "name": "deckent-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "deckent desktop shell (DESK-1, ADR-G-033) — thin Electron client over the system-Node `deckent serve` daemon. Never published to npm; distributed as its own signed artifact (Phase 4).",
  "type": "module",
  "main": "out/main/index.js",
  "author": "deckent",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bootstrap:electron": "node node_modules/electron/install.js",
    "package:linux": "electron-builder --linux dir"
  },
  "build": {
    "appId": "dev.deckent.desktop",
    "productName": "Deckent Desktop",
    "directories": { "output": "dist-app" },
    "files": ["out/**", "package.json"],
    "linux": { "target": "dir", "category": "Development" }
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.0",
    "zod": "^3.24.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.3",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "react-router": "7.9.4",
    "zustand": "5.0.14"
  }
}
